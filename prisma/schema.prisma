generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Contact {
  id          String        @id @default(cuid())
  name        String
  email       String
  phone       String
  service     String?
  description String?
  zone        String?
  source      String        @default("website")
  status      ContactStatus @default(NEW)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@map("contacts")
}

enum ContactStatus {
  NEW
  CONTACTED
  QUOTED
  CLOSED_WON
  CLOSED_LOST
}
