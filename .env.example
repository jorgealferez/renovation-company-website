# === Database ===
DATABASE_URL="postgresql://user:password@host:5432/renovation_db"

# === RabbitMQ ===
RABBITMQ_URL="amqp://user:password@host:5672"
RABBITMQ_EXCHANGE="renovation.events"
RABBITMQ_QUEUE="renovation.contacts"

# === NextAuth ===
NEXTAUTH_SECRET="change-me-in-production-min-32-chars"
NEXTAUTH_URL="https://yourdomain.com"

# === Admin credentials ===
ADMIN_EMAIL="admin@reformapro.es"
ADMIN_PASSWORD="change-me-in-production"

# === Google Analytics ===
NEXT_PUBLIC_GA_MEASUREMENT_ID="G-XXXXXXXXXX"

# === Site ===
NEXT_PUBLIC_SITE_URL="https://reformapro.es"
NEXT_PUBLIC_COMPANY_NAME="ReformaPro"
NEXT_PUBLIC_COMPANY_PHONE="+34 900 000 000"
NEXT_PUBLIC_COMPANY_EMAIL="info@reformapro.es"
NEXT_PUBLIC_COMPANY_ADDRESS="Calle Mayor 1, Madrid"
