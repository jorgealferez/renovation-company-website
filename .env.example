# ============================================================
# renovation-company-website — Environment Variables
# Copy this file to .env.local for local development.
# Set all variables in Railway Dashboard before deploying.
# NEXT_PUBLIC_* variables are embedded at build time (client-safe).
# ============================================================

# ── Database (required) ─────────────────────────────────────
# Railway provides this automatically when you add a PostgreSQL plugin.
DATABASE_URL="postgresql://user:password@host:5432/renovation_db"

# ── RabbitMQ (required for contact form) ────────────────────
# Use CloudAMQP free tier: https://www.cloudamqp.com
# Copy the "AMQP URL" from your CloudAMQP instance dashboard.
RABBITMQ_URL="amqp://user:password@hostname/vhost"
RABBITMQ_EXCHANGE="renovation.events"
RABBITMQ_QUEUE="renovation.contacts"

# ── NextAuth (required for /admin) ──────────────────────────
# Generate secret: openssl rand -base64 32
NEXTAUTH_SECRET="change-me-minimum-32-chars-random-string"
# Set to your public Railway URL or custom domain (no trailing slash).
NEXTAUTH_URL="https://your-service.up.railway.app"

# ── Admin credentials (required for /admin/contacts) ────────
ADMIN_EMAIL="admin@yourcompany.com"
ADMIN_PASSWORD="change-me-strong-password"

# ── Google Analytics 4 (optional) ───────────────────────────
# Create a GA4 property at https://analytics.google.com
# Format: G-XXXXXXXXXX
NEXT_PUBLIC_GA_MEASUREMENT_ID="G-XXXXXXXXXX"

# ── Site URL (required) ──────────────────────────────────────
# Used in sitemap, canonical URLs, and JSON-LD.
# Must match NEXTAUTH_URL exactly.
NEXT_PUBLIC_SITE_URL="https://your-service.up.railway.app"

# ── Company branding (all optional — defaults shown) ─────────
# Change these to rebrand the site without touching code.
NEXT_PUBLIC_COMPANY_NAME="ReformaPro"
NEXT_PUBLIC_COMPANY_PHONE="+34 900 000 000"
NEXT_PUBLIC_COMPANY_EMAIL="info@yourcompany.com"
NEXT_PUBLIC_COMPANY_ADDRESS="Calle Mayor 1, Madrid"

# ── GitHub Actions secrets (set in GitHub, NOT here) ─────────
# Required for the .github/workflows/deploy.yml auto-deploy workflow.
# Add these under: GitHub repo → Settings → Secrets → Actions
#
#   RAILWAY_TOKEN      → Railway Dashboard → Account Settings → Tokens
#   RAILWAY_PROJECT_ID → Railway Dashboard → Project → Settings → Project ID
